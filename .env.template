# RAG知识库配置文件
# 请复制此文件为 .env 并填入实际配置

# ================== LLM API配置 ==================
# LLM API密钥
API_KEY=your_api_key_here

# LLM服务URL
LLM_URL=https://your-llm-service.com/v1/chat/completions

# LLM模型名称
LLM_MODEL_NAME=Qwen3-32B-FP16

# ================== 嵌入模型配置 ==================
# Ollama嵌入模型名称 (需要本地安装Ollama)
EMBED_MODEL_NAME=nomic-embed-text:latest

# ================== 文档和数据库路径 ==================
# 文档目录路径 (存放PDF、TXT、HTML等文档)
DOCUMENTS_DIRECTORY=../euroncap_pdfs

# 向量数据库目录路径
VECTOR_DB_DIRECTORY=./euroncap_pdfs/chroma_db

# ================== 文本处理参数 ==================
# 文本块大小
CHUNK_SIZE=1000

# 文本块重叠大小
CHUNK_OVERLAP=150

# 检索返回的文档数量
RETRIEVE_K=20

# ================== Web服务配置 ==================
# 是否强制重建向量数据库 (true/false)
FORCE_REBUILD=false

# Web服务端口
WEB_PORT=8000

# Web服务主机地址
WEB_HOST=0.0.0.0